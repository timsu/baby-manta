{
  "name": "@manta/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "migrate": "DATABASE_URL=\"${DATABASE_URL:-file:./dev.db}\" prisma migrate dev",
    "migrate:deploy": "DATABASE_URL=\"${DATABASE_URL:-file:./dev.db}\" prisma migrate deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@manta/shared": "workspace:*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "typescript": "^5.7.2"
  }
}
