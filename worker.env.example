# Manta worker config — copy to .worker.env if you need to override ./start-worker defaults

# WebSocket URL of your Manta server. Defaults to the local web app
# (ws://localhost:5173); set this to run against a deployment.
MANTA_SERVER_URL=ws://localhost:5173

# No shared secret needed: the first run opens a browser to pair this machine to
# your Manta account. The token is saved to ~/.manta/worker-credentials.json and
# reused on every later start.

# Optional: a stable name for this worker (shown in server logs)
# WORKER_ID=my-laptop

# You normally do NOT need to list your repo credentials here. ./start-worker
# already adopts anything your interactive shell exports that a background login
# service would otherwise miss (vars set in .zshrc / .bashrc), so agent commands
# see the same environment your terminal does. Use this file only to pin a value
# for the worker specifically — entries here override the adopted environment.
# PLATFORM_DATABASE_URL=postgres://...

